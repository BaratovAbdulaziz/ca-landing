{
  "name": "counter-arena-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs --watch",
    "preview": "node scripts/serve.mjs",
    "check": "npm run build && node scripts/check.mjs",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "cf:dev": "wrangler dev",
    "deploy:check": "npm run check && wrangler deploy --dry-run",
    "deploy": "npm run check && wrangler deploy",
    "format": "prettier --write src scripts docs README.md FEATURES.md package.json .prettierrc.json wrangler.jsonc",
    "format:check": "prettier --check src scripts docs README.md FEATURES.md package.json .prettierrc.json wrangler.jsonc"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    }
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "wrangler": "4.148.0"
  }
}
